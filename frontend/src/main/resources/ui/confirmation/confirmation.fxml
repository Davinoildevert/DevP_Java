<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.ConfirmationController"
           prefWidth="1920" prefHeight="1080"
           styleClass="confirmRoot">

    <ScrollPane fx:id="scroll"
                fitToWidth="true"
                vbarPolicy="AS_NEEDED"
                hbarPolicy="NEVER"
                styleClass="confirmScroll">

        <content>
            <VBox alignment="CENTER"
                  spacing="18"
                  styleClass="confirmWrap">

                <!-- Titre -->
                <Label text="Confirmation de commande" styleClass="confirmTitle"/>

                <!-- Icône succès -->
                <Label text="✓" styleClass="successIcon"/>

                <!-- Sous-titre -->
                <Label text="Merci pour votre commande !" styleClass="confirmSubtitle"/>

                <!-- Num commande -->
                <Label fx:id="orderNumberLabel"
                       text="Commande N° #1234"
                       styleClass="orderNumber"/>

                <!-- Carte récapitulatif -->
                <VBox styleClass="recapCard" spacing="12">
                    <Label text="Récapitulatif" styleClass="recapTitle"/>

                    <GridPane fx:id="itemsGrid"
                              hgap="12"
                              vgap="10"
                              styleClass="itemsGrid"/>

                    <Region styleClass="recapDivider"/>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total" styleClass="totalLabel"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalLabel"
                               text="41,20 €"
                               styleClass="totalValue"/>
                    </HBox>
                </VBox>

                <Label text="Veuillez patienter, votre commande est en préparation"
                       styleClass="statusText"/>

                <Button text="Nouvelle commande"
                        onAction="#onNouvelleCommande"
                        styleClass="ctaYellow"/>

            </VBox>
        </content>

    </ScrollPane>
</StackPane>

