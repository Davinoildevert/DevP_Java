<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.Region?>


<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.AccueilController"
           styleClass="screen">

    <!-- Background slider : on le rend non cliquable -->
    <StackPane fx:id="sliderPane" maxWidth="Infinity" maxHeight="Infinity" mouseTransparent="true">
        <StackPane fx:id="slideA" maxWidth="Infinity" maxHeight="Infinity">
            <ImageView fx:id="bgBlurA"/>
            <ImageView fx:id="bgMainA" preserveRatio="true" smooth="true"/>
        </StackPane>

        <StackPane fx:id="slideB" maxWidth="Infinity" maxHeight="Infinity">
            <ImageView fx:id="bgBlurB"/>
            <ImageView fx:id="bgMainB" preserveRatio="true" smooth="true"/>
        </StackPane>
    </StackPane>

    <!-- Overlay sombre (ne bloque pas les clics) -->
    <StackPane styleClass="clickable overlay" mouseTransparent="true"/>

    <!-- Contenu central : on le met en haut + marge -->
    <VBox alignment="CENTER"
          spacing="25"
          pickOnBounds="true"
          StackPane.alignment="TOP_CENTER">
        <StackPane.margin>
            <Insets top="10" right="0" bottom="0" left="0"/>
        </StackPane.margin>

        <Label text="Asiatik Express" styleClass="brand"/>

        <Button fx:id="startBtn"
                text="TOUCHEZ POUR COMMENCER"
                styleClass="cta"
                onAction="#onStart"/>

        <Label text="Commandez vos plats en quelques étapes" styleClass="subtitle"/>
    </VBox>

    <!-- Boutons en bas : en bas + marge bottom -->
    <VBox alignment="CENTER"
          StackPane.alignment="BOTTOM_CENTER">
        <StackPane.margin>
            <Insets top="550" right="0" bottom="80" left="0"/>
        </StackPane.margin>

        <HBox alignment="CENTER" spacing="18">
            <Button fx:id="btnFR" text="FR" styleClass="langBtn" onAction="#onFR"/>
            <Button fx:id="btnEN" text="EN" styleClass="langBtn" onAction="#onEN"/>
            <Button fx:id="btnAide" text="Aide" styleClass="helpBtn" onAction="#onAide"/>
        </HBox>
    </VBox>


<!-- ✅ MODAL "Fonctionnalité indisponible" -->
<StackPane fx:id="infoOverlay"
           visible="false"
           alignment="CENTER"
           pickOnBounds="true"
           style="-fx-background-color: rgba(0,0,0,0.55);">

    <VBox spacing="14"
          alignment="CENTER"
          prefHeight="260"
          maxHeight="260"
          style="-fx-background-color: white;
                 -fx-background-radius: 18;
                 -fx-padding: 22 26;
                 -fx-min-width: 520;
                 -fx-max-width: 520;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.30), 30, 0.25, 0, 10);">

        <!-- Header : titre + croix -->
        <HBox alignment="CENTER_LEFT">
            <Label fx:id="infoTitleLabel"
                   text="Information"
                   style="-fx-font-size: 22px; -fx-font-weight: 900;" />

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="✕"
                    onAction="#onCloseInfo"
                    style="-fx-background-color: transparent;
                           -fx-font-size: 18px;
                           -fx-font-weight: 900;
                           -fx-text-fill: #111;" />
        </HBox>

        <Label fx:id="infoMessageLabel"
               text="Cette fonctionnalité n'est pas encore disponible."
               wrapText="true"
               style="-fx-font-size: 16px; -fx-text-fill: #444;" />

        <HBox spacing="12" alignment="CENTER">
            <Button text="Fermer"
                    onAction="#onCloseInfo"
                    style="-fx-background-color: #fbc02d;
                           -fx-background-radius: 12;
                           -fx-padding: 10 28;
                           -fx-font-size: 14px;
                           -fx-font-weight: 900;" />
        </HBox>

    </VBox>
</StackPane>

</StackPane>
