<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.PaiementController"
           prefWidth="1920" prefHeight="1080">

    <!-- Fond optionnel (si tu veux garder la cohérence, sinon supprime) -->
    <ImageView fx:id="bgImage"
               fitWidth="1920" fitHeight="1080"
               preserveRatio="false"
               opacity="0.22"
               mouseTransparent="true"/>

    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(0,0,0,0.25);"/>

    <BorderPane prefWidth="1920" prefHeight="1080" style="-fx-background-color: transparent;">

        <top>
            <HBox alignment="CENTER" style="-fx-padding: 18 22;">
                <Label text="Paiement"
                       style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: white;"/>
            </HBox>
        </top>

        <center>
            <VBox spacing="18" style="-fx-padding: 10 70 30 70;" alignment="TOP_CENTER">

                <!-- Carte principale -->
                <VBox spacing="16"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 18;
                             -fx-padding: 22;
                             -fx-min-width: 720;
                             -fx-max-width: 720;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.2, 0, 8);">

                    <Label text="Choisissez votre moyen de paiement"
                           style="-fx-font-size: 22px; -fx-font-weight: 900;"/>

                    <!-- Total -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(0,0,0,0.04);
                                 -fx-background-radius: 14;
                                 -fx-padding: 12;">
                        <Label text="Montant à payer :"
                               style="-fx-font-size: 16px; -fx-font-weight: 800;"/>
                        <Label fx:id="amountLabel" text="0,00 €"
                               style="-fx-font-size: 18px; -fx-font-weight: 900;"/>
                    </HBox>

                    <!-- Choix -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <RadioButton fx:id="cardRadio" text="Carte bancaire"
                                     style="-fx-font-size: 16px; -fx-font-weight: 800;"/>
                        <RadioButton fx:id="nfcRadio" text="Sans contact (NFC)"
                                     style="-fx-font-size: 16px; -fx-font-weight: 800;"/>
                    </HBox>

                    <!-- Formulaire carte -->
                    <VBox fx:id="cardBox" spacing="10"
                          style="-fx-background-color: rgba(0,0,0,0.03);
                                 -fx-background-radius: 14;
                                 -fx-padding: 14;">
                        <Label text="Informations carte (simulation)"
                               style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: 800;"/>

                        <TextField fx:id="cardNumberField" promptText="Numéro de carte (ex: 4242 4242 4242 4242)"/>

                        <HBox spacing="12">
                            <TextField fx:id="expField" promptText="MM/AA" prefWidth="120"/>
                            <TextField fx:id="cvvField" promptText="CVV" prefWidth="120"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <!-- Zone NFC -->
                    <VBox fx:id="nfcBox" spacing="10" visible="false" managed="false"
                          style="-fx-background-color: rgba(0,0,0,0.03);
                                 -fx-background-radius: 14;
                                 -fx-padding: 14;">
                        <Label text="Paiement sans contact (simulation)"
                               style="-fx-font-size: 14px; -fx-text-fill: #444; -fx-font-weight: 800;"/>
                        <Label text="Approchez votre carte / téléphone du terminal NFC."
                               style="-fx-font-size: 16px; -fx-text-fill: #222;"/>
                    </VBox>

                    <Label fx:id="statusLabel" text=""
                           style="-fx-text-fill: #d32f2f; -fx-font-size: 14px; -fx-font-weight: 800;"/>

                    <Label text="Paiement simulé : aucune donnée bancaire réelle n’est enregistrée."
                           style="-fx-text-fill: #666; -fx-font-size: 13px;"/>

                    <!-- Boutons -->
                    <HBox spacing="18" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                        <Button text="← Retour"
                                onAction="#onRetour"
                                style="-fx-background-color: white;
                                       -fx-border-color: #111;
                                       -fx-border-width: 2;
                                       -fx-background-radius: 14;
                                       -fx-border-radius: 14;
                                       -fx-padding: 12 28;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: 800;"/>

                        <Button text="Payer"
                                onAction="#onPayer"
                                style="-fx-background-color: #fbc02d;
                                       -fx-background-radius: 14;
                                       -fx-padding: 12 34;
                                       -fx-font-size: 14px;
                                       -fx-font-weight: 900;"/>
                    </HBox>

                </VBox>
            </VBox>
        </center>

    </BorderPane>
</StackPane>
