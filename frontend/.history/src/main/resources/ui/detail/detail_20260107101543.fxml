<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.DetailController"
           prefWidth="1920" prefHeight="1080">

    <!-- ✅ Fond slideshow -->
    <ImageView fx:id="bgImage"
               fitWidth="1920" fitHeight="1080"
               preserveRatio="false"
               opacity="0.22"
               mouseTransparent="true"/>

    <!-- ✅ léger voile seulement pour calmer le fond (pas gris sale) -->
    <Region mouseTransparent="true"
            style="-fx-background-color: rgba(0,0,0,0.25);"/>

    <!-- ✅ Layout -->
    <BorderPane prefWidth="1920" prefHeight="1080"
                style="-fx-background-color: transparent;">

        <!-- Top -->
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <padding><Insets top="18" right="22" bottom="8" left="22"/></padding>

                <Button text="←" onAction="#onBackCatalogue"
                        style="-fx-font-size: 18px; -fx-background-color: transparent; -fx-text-fill: white;"/>

                <Label text="Détail du plat"
                       style="-fx-font-size: 34px; -fx-font-weight: 900; -fx-text-fill: white;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="cartTotalBtn"
                        text="🧺  0,00 €"
                        onAction="#onOpenPanier"
                        style="-fx-background-color: #fbc02d;
                               -fx-font-weight: 800;
                               -fx-background-radius: 18;
                               -fx-padding: 10 18;"/>
            </HBox>
        </top>

        <!-- Center -->
        <center>
            <HBox spacing="28" alignment="TOP_LEFT">
                <padding><Insets top="18" right="40" bottom="18" left="40"/></padding>

                <!-- ✅ CARTE IMAGE -->
                <VBox prefWidth="650"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 18;
                             -fx-padding: 18;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.2, 0, 8);">

                    <StackPane prefWidth="610" prefHeight="420"
                               style="-fx-background-color: #e6e6e6; -fx-background-radius: 14;">
                        <ImageView fx:id="productImage"
                                   fitWidth="610" fitHeight="420"
                                   preserveRatio="false"/>
                    </StackPane>
                </VBox>

                <!-- ✅ CARTE INFOS -->
                <VBox spacing="14" prefWidth="900"
                      style="-fx-background-color: rgba(255,255,255,0.95);
                             -fx-background-radius: 18;
                             -fx-padding: 26;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.2, 0, 8);">

                    <Label fx:id="nameLabel"
                           text="Curry rouge"
                           style="-fx-font-size: 40px; -fx-font-weight: 900;"/>

                    <Label fx:id="descLabel"
                           text="Nouilles sautées avec crevettes, légumes et sauce tamarin"
                           wrapText="true"
                           style="-fx-font-size: 20px; -fx-text-fill: #555;"/>

                    <Label fx:id="priceLabel"
                           text="14,90 €"
                           style="-fx-font-size: 36px; -fx-font-weight: 900;"/>

                    <Label text="Options" style="-fx-font-size: 28px; -fx-font-weight: 900;"/>

                    <!-- Epice -->
                    <VBox spacing="6">
                        <Label text="Épice : doux / moyen / fort" style="-fx-font-size: 18px;"/>
                        <HBox spacing="16">
                            <RadioButton fx:id="rbDoux" text="Doux" toggleGroup="$tgEpice"/>
                            <RadioButton fx:id="rbMoyen" text="Moyen" toggleGroup="$tgEpice" selected="true"/>
                            <RadioButton fx:id="rbFort" text="Fort" toggleGroup="$tgEpice"/>
                        </HBox>
                    </VBox>

                    <!-- Accompagnement -->
                    <VBox spacing="6">
                        <Label text="Accompagnement : riz / nouilles" style="-fx-font-size: 18px;"/>
                        <HBox spacing="16">
                            <RadioButton fx:id="rbRiz" text="Riz" toggleGroup="$tgAcc" selected="true"/>
                            <RadioButton fx:id="rbNouilles" text="Nouilles" toggleGroup="$tgAcc"/>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <!-- Quantité + CTA -->
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="Quantité" style="-fx-font-size: 24px; -fx-font-weight: 900;"/>

                        <Button text="−" onAction="#onMinus"
                                style="-fx-font-size: 18px; -fx-padding: 8 14; -fx-background-radius: 10;"/>
                        <Label fx:id="qtyLabel" text="1"
                               style="-fx-font-size: 22px; -fx-font-weight: 900;"/>
                        <Button text="+" onAction="#onPlus"
                                style="-fx-font-size: 18px; -fx-padding: 8 14; -fx-background-radius: 10;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="Ajouter au panier" onAction="#onAddToCart"
                                style="-fx-background-color: #fbc02d;
                                       -fx-font-size: 22px;
                                       -fx-font-weight: 900;
                                       -fx-background-radius: 22;
                                       -fx-padding: 12 26;"/>
                    </HBox>

                </VBox>
            </HBox>
        </center>

    </BorderPane>

</StackPane>
