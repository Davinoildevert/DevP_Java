<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.Rectangle?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           prefWidth="1920" prefHeight="1080"
           styleClass="screen">

    <!-- Background layers -->
    <StackPane styleClass="bg">
        <Region styleClass="bgBase"/>
        <Region styleClass="bgGlowRed"/>
        <Region styleClass="bgGlowGold"/>
        <Region styleClass="bgPattern"/>
        <Region styleClass="bgVignette"/>
    </StackPane>

    <!-- Main glass card -->
    <BorderPane maxWidth="1180" maxHeight="680" styleClass="glassCard">
        <center>
            <VBox alignment="CENTER" spacing="18">

                <Label text="Asiatik Express" styleClass="brand"/>

                <Label text="Une expérience rapide, chaude et savoureuse"
                       styleClass="tagline"/>

                <!-- CTA with subtle “shine” overlay -->
                <StackPane>
                    <Button text="TOUCHEZ POUR COMMENCER"
                            styleClass="cta"/>
                    <Rectangle width="860" height="110" arcWidth="44" arcHeight="44" styleClass="ctaShine"/>
                </StackPane>

                <Label text="Commandez vos plats en quelques étapes"
                       styleClass="subtitle"/>

            </VBox>
        </center>

        <bottom>
            <HBox alignment="CENTER" spacing="18" styleClass="bottomRow">
                <Button text="FR" styleClass="pill"/>
                <Button text="EN" styleClass="pill"/>
                <Button text="Aide" styleClass="pill"/>
            </HBox>
        </bottom>
    </BorderPane>

</StackPane>
