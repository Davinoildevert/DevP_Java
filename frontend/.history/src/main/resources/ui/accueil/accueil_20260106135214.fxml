<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.ui.AccueilController"
           prefWidth="1920"
           prefHeight="1080"
           styleClass="screen">

    <!-- ================= BACKGROUND SLIDER ================= -->
    <StackPane fx:id="sliderPane" prefWidth="1920" prefHeight="1080">

        <!-- -------- SLIDE A -------- -->
        <StackPane fx:id="slideA">
            <!-- Fond flouté (cover, remplit tout) -->
            <ImageView fx:id="bgBlurA"/>

            <!-- Image principale (contain, on voit tout le dessin) -->
            <ImageView fx:id="bgMainA"
                       preserveRatio="true"
                       smooth="true"/>
        </StackPane>

        <!-- -------- SLIDE B -------- -->
        <StackPane fx:id="slideB">
            <!-- Fond flouté -->
            <ImageView fx:id="bgBlurB"/>

            <!-- Image principale -->
            <ImageView fx:id="bgMainB"
                       preserveRatio="true"
                       smooth="true"/>
        </StackPane>

    </StackPane>
    <!-- ===================================================== -->

    <!-- DARK OVERLAY (lisibilité texte) -->
    <StackPane styleClass="overlay"/>

    <!-- ================= CONTENT ================= -->
    <VBox alignment="CENTER" spacing="25">
        <Label text="Asiatik Express" styleClass="brand"/>
        <Button text="TOUCHEZ POUR COMMENCER" styleClass="cta"/>
        <Label text="Commandez vos plats en quelques étapes"
               styleClass="subtitle"/>
    </VBox>
    <!-- =========================================== -->

</StackPane>
